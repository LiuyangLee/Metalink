        s_fa_05 = expand(path + 'results/b-sample/07_contigs/contigs_fna/{sample}.fna', sample=SAMPLE_INDEX),
        s_tv_06 = expand(path + 'results/b-sample/08_gather_bin_high_quality/checkm_stats/{sample}.csv', sample=SAMPLE_INDEX),
