rule b_end_target:
    input:
        s_raw_stats_r1 = expand(path + 'results/b-sample/00_raw_stats/{sample}_raw_1.fastq.stats', sample=SAMPLE_INDEX),
        s_raw_stats_r2 = expand(path + 'results/b-sample/00_raw_stats/{sample}_raw_2.fastq.stats', sample=SAMPLE_INDEX),
        s_trim_r1 = expand(path + 'results/b-sample/01_trim/{sample}_trimmed_1.fastq.gz', sample=SAMPLE_INDEX),
        s_trim_r2 = expand(path + 'results/b-sample/01_trim/{sample}_trimmed_2.fastq.gz', sample=SAMPLE_INDEX),
        s_trim_stats_r1 = expand(path + 'results/b-sample/01_trim_stats/{sample}_trimmed_1.fastq.stats', sample=SAMPLE_INDEX),
        s_trim_stats_r2 = expand(path + 'results/b-sample/01_trim_stats/{sample}_trimmed_2.fastq.stats', sample=SAMPLE_INDEX),
