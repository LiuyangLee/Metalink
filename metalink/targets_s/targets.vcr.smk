rule vcr_end_target:
    input:
        p_b_mk_11 =  expand(path + 'results/b-project/01_cat_raw_stats/{project}/01_raw_reads_stats.tsv', project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        p_b_mk_12 =  expand(path + 'results/b-project/02_cat_trimmed_stats/{project}/02_clean_reads_stats.tsv', project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        p_b_mk_13 =  expand(path + 'markers/b-project/03_contigs_stats/{project}/03_contigs_stats.mk', project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        p_b_mk_14 =  expand(path + 'results/b-project/04_merge_reads_contigs_stats/{project}/04_reads_contigs_ffn_stats.tsv', project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        s_gz_03_s  = expand(path + 'results/vcr-sample/03_taxonomy/kraken2/unmapped_reads_singleton/{sample}.kraken2.read2classification.tsv.gz', sample=SAMPLE_INDEX),
        s_ffn_len  = expand(path + 'results/vcr-sample/02_FragGeneScanRs/{sample}_unmapped_s.ffn_length.gz', sample=SAMPLE_INDEX),
        s_ffn_stats  = expand(path + 'results/vcr-sample/02_FragGeneScanRs_stats/{sample}_unmapped_s.fna.stats', sample=SAMPLE_INDEX),
        s_fun_mk  = expand(path + 'markers/vcr-sample/04_function/classify_done/{sample}.mk', sample=SAMPLE_INDEX),
        s_merge_05 = expand(path + 'results/vcr-sample/05_merge_tax_fun_depth/KO_Taxa_RelativeAbundance/{sample}.KO_Taxa_RelativeAbundance.Taxa.tsv', sample=SAMPLE_INDEX),
        s_mc_05 = expand(path + 'markers/vcr-sample/05_visualize/{sample}.mk', sample=SAMPLE_INDEX),
        s_mc_06 = expand(path + 'markers/vcr-sample/06_module_completeness/{sample}.{rank}.mk',rank=RANKS, sample=SAMPLE_INDEX),
         merged_stats = expand(path + 'results/vcr-project/00_FragGeneScanRs_stats/{project}/02_FGS_stats.tsv',project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        s_Ta_out_long = expand(path + 'results/vcr-project/01_Taxa_Sample/{project}/Taxa_Sample.long.tsv', project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        p_KO_out_long = expand(path + 'results/vcr-project/02_KO_Sample/{project}/KO_Sample.long.tsv', project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        s_Ta_plot_mk = expand(path + 'markers/vcr-project/01_Taxa_visualization/{project}.mk', project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        s_KO_plot_mk = expand(path + 'markers/vcr-project/03_Fun_visualization/{project}.mk', project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        p_mc_mk = expand(path + 'markers/vcr-project/03_community_module/{project}.mk',project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        p_mc_mk3 = expand(path + 'markers/vcr-project/06_module_completeness/{project}/{rank}.mk',project=PROJECT_INDEX, rank=RANKS) if RUN_PROJECT_LEVEL else [],
        p_out_long_mc = expand(path + 'results/vcr-project/05_merge_tax_KO_depth/{project}/{rank}.mean.long.tsv',rank=RANKS, project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        p_out_long_Module_RelativeAbundance = expand(path + 'results/vcr-project/05_merge_tax_Module_RelativeAbundance/{project}/{rank}.mean.long.tsv',rank=RANKS, project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        p_out_long_Module_SumCoverage = expand(path + 'results/vcr-project/05_merge_tax_Module_SumCoverage/{project}/{rank}.mean.long.tsv',rank=RANKS, project=PROJECT_INDEX) if RUN_PROJECT_LEVEL else [],
        s_mk_12 = expand(path + 'markers/vcr-sample/12_delete_bam/{sample}.mk', sample=SAMPLE_INDEX) if not keep_intermediate('bam') else [],
        s_mk_13 = expand(path + 'markers/v-sample/12_delete_vs2_iter0/{sample}.mk', sample=SAMPLE_INDEX) if not keep_intermediate('vs2_iter0') else [],
        s_mk_14 = expand(path + 'markers/v-sample/12_delete_bam/{sample}.mk', sample=SAMPLE_INDEX) if not keep_intermediate('bam') else [],
        s_b_mk_03 = expand(path + 'markers/b-sample/03_delete_assembly_intermediate/{sample}.mk', sample=SAMPLE_INDEX) if config.get('skip_level', 0) < 2 and not keep_intermediate('assembly') else [],
